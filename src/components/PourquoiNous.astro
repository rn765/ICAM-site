---
// Section Ce qui nous distingue — fond bleu nuit, 3 cards, icônes or laiton
const cards = [
  {
    title: "Un seul interlocuteur",
    body: "Vous parlez toujours à la même personne. Pas de centre d'appels, pas de chatbot, pas de transfert entre départements. Joignable directement, réponse rapide.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>`
  },
  {
    title: "Transparence financière",
    body: "Commission unique, taux clair selon le type de bien. Sur Airbnb, prélèvement automatique en tant que co-hôte. Sur Booking, facture mensuelle détaillée. Aucun frais caché, vous savez toujours ce que vous payez et pourquoi.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" /></svg>`
  },
  {
    title: "Conformité encadrée",
    body: "Nous vous accompagnons sur les obligations administratives liées à la location courte durée en Belgique. Nous vous informons des démarches à effectuer (enregistrement régional, taxe de séjour, déclarations fiscales) et vous orientons vers les bons interlocuteurs.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`
  },
];
---

<!-- Fond bleu nuit — tranche visuelle forte -->
<section
  id="pourquoi-nous"
  class="py-12 md:py-20 px-4"
  style="background-color:var(--color-primary);"
  aria-labelledby="pourquoi-heading"
>
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-14 fade-in-section">
      <h2
        id="pourquoi-heading"
        class="font-serif font-semibold text-[var(--color-bg)]"
        style="font-family:'Fraunces',serif;font-size:clamp(1.75rem,3vw,2.5rem);"
      >Ce qui nous distingue</h2>
    </div>

    <!-- Grille 3 cards — fond semi-transparent sur bleu nuit -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {cards.map((c, i) => (
        <div
          class="fade-in-section rounded-sm p-5 md:p-8"
          style={`background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);transition-delay:${i * 80}ms;`}
        >
          <!-- Icône or laiton -->
          <div class="mb-5" style="color:var(--color-accent);" set:html={c.icon} />
          <h3
            class="font-serif font-semibold text-[var(--color-bg)] text-lg mb-3"
            style="font-family:'Fraunces',serif;"
          >{c.title}</h3>
          <p class="font-sans text-sm leading-relaxed" style="color:rgba(244,239,230,0.70);">{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
