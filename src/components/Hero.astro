---
// Section Hero — pleine hauteur, Belgique, overlay bleu nuit
const whatsappUrl = "https://wa.me/32471596624?text=Bonjour%2C%20je%20souhaite%20des%20informations%20sur%20la%20gestion%20de%20mon%20bien.";
---

<section
  class="relative flex items-center justify-center min-h-[90vh] md:min-h-screen px-4 py-20 overflow-hidden"
  aria-label="Introduction ICAM Conciergerie"
>
  <!-- Image de fond — intérieur appartement haut de gamme -->
  <img
    src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=1920&q=85"
    alt=""
    role="presentation"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
    fetchpriority="high"
    onerror="this.src='https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=1920&q=85';this.onerror=function(){this.src='https://images.unsplash.com/photo-1567016432779-094069958ea5?w=1920&q=85'}"
  />

  <!-- Overlay bleu nuit -->
  <div
    class="absolute inset-0"
    style="background:linear-gradient(to bottom,rgba(15,30,61,0.55),rgba(15,30,61,0.82));"
    aria-hidden="true"
  ></div>

  <!-- Contenu centré -->
  <div class="relative z-10 max-w-3xl mx-auto text-center">
    <h1
      class="font-serif font-semibold text-white leading-tight mb-6"
      style="font-family:'Fraunces',serif;font-size:clamp(2rem,5vw,4rem);"
    >
      Rentabilisez votre bien en location courte durée, partout en Belgique.
    </h1>

    <p
      class="font-sans text-white mb-10 max-w-2xl mx-auto leading-relaxed"
      style="font-size:clamp(1rem,2.5vw,1.25rem);opacity:0.9;"
    >
      ICAM Conciergerie prend en charge la coordination complète de votre location Airbnb, Booking et autres plateformes. Vous percevez vos revenus, nous nous occupons du reste.
    </p>

    <!-- Boutons CTA -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <!-- Bouton primaire : scroll vers simulateur -->
      <button
        id="hero-cta-simulateur"
        class="inline-flex items-center gap-2 px-7 py-4 bg-[var(--color-accent)] text-white font-sans font-semibold text-base rounded-sm hover:opacity-90 active:scale-95 transition-all"
        aria-label="Estimer mes revenus — accéder au simulateur"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V13.5zm0 2.25h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V18zm2.498-6.75h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V13.5zm0 2.25h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V18zm2.504-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zm0 2.25h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V18zm2.498-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zM8.25 6h7.5v2.25h-7.5V6zM12 2.25c-1.892 0-3.758.11-5.593.322C5.307 2.7 4.5 3.522 4.5 4.52V19.5a2.25 2.25 0 002.25 2.25h10.5A2.25 2.25 0 0019.5 19.5V4.52c0-.998-.807-1.821-1.907-1.948A48.507 48.507 0 0012 2.25z" />
        </svg>
        Estimer mes revenus
      </button>
      <!-- Bouton secondaire : WhatsApp -->
      <a
        href={whatsappUrl}
        class="inline-flex items-center gap-2 px-7 py-4 border-2 border-white text-white font-sans font-semibold text-base rounded-sm hover:bg-white/10 active:scale-95 transition-all"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Nous écrire sur WhatsApp"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Nous écrire sur WhatsApp
      </a>
    </div>

    <!-- Micro-copy rassurant -->
    <p class="mt-5 text-sm font-sans" style="color:rgba(255,255,255,0.80);">
      Réponse sous 24h. Aucun engagement avant échange.
    </p>
  </div>
</section>

<script>
  // Scroll smooth vers le simulateur depuis le hero
  document.getElementById('hero-cta-simulateur')?.addEventListener('click', () => {
    document.getElementById('simulateur')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
