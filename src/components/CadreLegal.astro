---
// Section Cadre légal — fond crème, informatif, toute la Belgique
const items = [
  {
    num: '1',
    title: 'Enregistrement régional',
    body: "Selon la région où se situe votre bien (Bruxelles-Capitale, Flandre, Wallonie), un enregistrement préalable peut être requis avant la première mise en location. À Bruxelles, par exemple, l'enregistrement auprès de Bruxelles Économie et Emploi est obligatoire."
  },
  {
    num: '2',
    title: 'Taxe de séjour',
    body: "La taxe de séjour varie selon la commune où se trouve votre bien : montant par nuit, modalités de déclaration, périodicité. Elle est prélevée auprès du voyageur et reversée par le propriétaire à la commune concernée."
  },
  {
    num: '3',
    title: 'Affectation urbanistique',
    body: "Au-delà d'un certain nombre de jours de location touristique par an (variable selon la région), votre bien peut nécessiter un changement d'affectation et un permis spécifique. Nous vous informons des seuils applicables à votre situation."
  },
];
---

<!-- Fond crème — section informative, moins anxiogène -->
<section
  id="cadre-legal"
  class="bg-[var(--color-bg)] py-12 md:py-20 px-4"
  aria-labelledby="legal-heading"
>
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-6 fade-in-section">
      <h2
        id="legal-heading"
        class="font-serif font-semibold text-[var(--color-primary)]"
        style="font-family:'Fraunces',serif;font-size:clamp(1.75rem,3vw,2.5rem);"
      >
        Louer en courte durée en Belgique
      </h2>
    </div>
    <div class="text-center mb-10 fade-in-section">
      <p class="font-sans text-[var(--color-text)] opacity-60 max-w-xl mx-auto text-base leading-relaxed italic">
        Quelques règles à connaître avant de vous lancer
      </p>
    </div>

    <!-- Texte intro -->
    <div class="fade-in-section mb-12 max-w-2xl mx-auto text-center">
      <p class="font-sans text-[var(--color-text)] opacity-70 leading-relaxed text-base">
        La location courte durée est encadrée différemment selon votre région et votre commune. En tant que propriétaire, voici les obligations principales dont vous restez responsable :
      </p>
    </div>

    <!-- 3 obligations numérotées -->
    <div class="flex flex-col gap-8 mb-12">
      {items.map((item) => (
        <div class="fade-in-section flex gap-6 items-start p-6 bg-white border border-[var(--color-border)] rounded-sm">
          <!-- Numéro or laiton -->
          <span
            class="font-serif font-semibold flex-shrink-0 leading-none"
            style="font-family:'Fraunces',serif;color:var(--color-accent);font-size:2.5rem;"
            aria-hidden="true"
          >{item.num}</span>
          <div class="pt-1">
            <h3
              class="font-serif font-semibold text-[var(--color-primary)] text-lg mb-2"
              style="font-family:'Fraunces',serif;"
            >{item.title}</h3>
            <p class="font-sans text-[var(--color-text)] opacity-70 leading-relaxed text-base">{item.body}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Phrase de clôture — positionnement clair d'ICAM -->
    <div class="fade-in-section border-t border-[var(--color-border)] pt-10 text-center">
      <p
        class="font-sans italic text-[var(--color-text)] opacity-60 max-w-2xl mx-auto leading-relaxed"
        style="font-size:1rem;"
      >
        ICAM Conciergerie vous informe et vous oriente sur ces démarches. Le propriétaire reste responsable de leur exécution conformément à la législation en vigueur.
      </p>
    </div>
  </div>
</section>
