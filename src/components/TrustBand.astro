---
// Bande Trust — logos textuels des plateformes de réservation
const platforms = [
  { name: 'Airbnb',       color: '#FF5A5F', weight: '700' },
  { name: 'Booking.com',  color: '#003580', weight: '700' },
  { name: 'Abritel',      color: '#FF6600', weight: '700' },
  { name: 'Expedia',      color: '#FFC72C', weight: '700' },
];
---

<div class="bg-[var(--color-bg)] border-b border-[var(--color-border)] py-6 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <p class="font-sans text-xs text-[var(--color-text)] opacity-50 uppercase tracking-widest mb-5">
      Vos biens visibles sur les meilleures plateformes :
    </p>

    <!-- Desktop : ligne unique — Mobile : grille 2×2 -->
    <div class="grid grid-cols-2 md:flex md:flex-row md:justify-center md:items-center gap-6 md:gap-10 lg:gap-14">
      {platforms.map((p) => (
        <span
          class="font-sans text-xl md:text-2xl transition-opacity duration-200 cursor-default select-none text-center"
          style={`font-weight:${p.weight};color:${p.color};opacity:0.65;`}
          onmouseenter="this.style.opacity='1'"
          onmouseleave="this.style.opacity='0.65'"
          aria-label={p.name}
        >
          {p.name}
        </span>
      ))}
    </div>
  </div>
</div>
