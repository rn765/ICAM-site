---
// Navigation sticky — ICAM Conciergerie
const links = [
  { href: '#methode', label: 'Méthode' },
  { href: '#tarifs', label: 'Tarifs' },
  { href: '#faq', label: 'FAQ' },
  { href: '#contact', label: 'Contact' },
];
---

<header
  id="main-nav"
  class="sticky top-0 z-40 bg-[var(--color-bg)] transition-shadow duration-300"
  role="banner"
>
  <nav
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16 md:h-20"
    aria-label="Navigation principale"
  >
    <!-- Wordmark texte -->
    <a href="/" class="block" aria-label="ICAM Conciergerie — Accueil">
      <span class="font-serif text-2xl md:text-3xl font-medium text-[#0F1E3D] tracking-wide" style="font-family:'Fraunces',serif;">ICAM</span>
      <span class="font-sans text-xs md:text-sm uppercase tracking-[0.2em] text-[#B89968] ml-2">Conciergerie</span>
    </a>

    <!-- Ancres desktop -->
    <ul class="hidden md:flex items-center gap-6 lg:gap-8 list-none" role="list">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="font-sans font-medium text-sm text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors"
          >{label}</a>
        </li>
      ))}
    </ul>

    <!-- CTAs desktop -->
    <div class="hidden md:flex items-center gap-2">
      <a
        href="mailto:contact@icam-conciergerie.com"
        class="inline-flex items-center gap-2 px-4 py-2 border border-[#0F1E3D] text-[#0F1E3D] rounded-md text-sm font-medium hover:bg-[#0F1E3D] hover:text-white transition-colors font-sans"
        aria-label="Envoyer un email à ICAM Conciergerie"
        data-track="click_email"
        data-track-location="nav"
      >Email</a>
      <a
        href="https://wa.me/32471596624?text=Bonjour%2C%20je%20souhaite%20des%20informations%20sur%20la%20gestion%20de%20mon%20bien."
        class="inline-flex items-center gap-2 px-4 py-2 bg-[var(--color-accent)] text-white font-sans font-medium text-sm rounded-sm hover:opacity-90 transition-opacity"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Nous contacter sur WhatsApp"
        data-track="click_whatsapp"
        data-track-location="nav"
      >WhatsApp</a>
    </div>

    <!-- Hamburger mobile -->
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5"
      aria-label="Ouvrir le menu de navigation"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="block w-6 h-0.5 bg-[var(--color-primary)]"></span>
      <span class="block w-6 h-0.5 bg-[var(--color-primary)]"></span>
      <span class="block w-5 h-0.5 bg-[var(--color-primary)]"></span>
    </button>
  </nav>
</header>

<!-- Overlay menu mobile full-screen -->
<div
  id="mobile-menu"
  class="nav-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Menu de navigation"
>
  <button
    id="menu-close"
    class="absolute top-5 right-5 w-10 h-10 flex items-center justify-center text-white text-2xl"
    aria-label="Fermer le menu"
  >✕</button>

  <ul class="flex flex-col items-center gap-6 list-none text-center" role="list">
    {links.map(({ href, label }) => (
      <li>
        <a
          href={href}
          class="font-serif text-2xl text-white hover:text-[var(--color-accent)] transition-colors mobile-nav-link"
          style="font-family:'Fraunces',serif;"
        >{label}</a>
      </li>
    ))}
    <li class="mt-4">
      <a
        href="https://wa.me/32471596624?text=Bonjour%2C%20je%20souhaite%20des%20informations%20sur%20la%20gestion%20de%20mon%20bien."
        class="px-8 py-3 bg-[var(--color-accent)] text-white font-sans font-medium text-base rounded-sm"
        target="_blank"
        rel="noopener noreferrer"
      >Nous écrire sur WhatsApp</a>
    </li>
  </ul>
</div>

<script>
  // Hamburger menu mobile
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const close = document.getElementById('menu-close');

  const openMenu = () => {
    menu?.classList.add('open');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };

  const closeMenu = () => {
    menu?.classList.remove('open');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  toggle?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);

  // Fermer au clic sur une ancre
  document.querySelectorAll('.mobile-nav-link').forEach((l) =>
    l.addEventListener('click', closeMenu)
  );

  // Fermer avec Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('open')) closeMenu();
  });
</script>
