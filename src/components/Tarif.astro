---
// Section Tarifs — 3 cards avec prestations incluses, boutons → #simulateur
const tarifs = [
  {
    label: 'Studio · 1 chambre',
    percent: '20 %',
    tag: 'TTC',
    services: [
      'Photos professionnelles & annonces optimisées',
      'Tarification dynamique (saisonnalité, événements)',
      'Communication voyageurs 24 h/24, 7 j/7',
      'Organisation check-in / check-out',
      'Coordination ménage & linge de maison',
      'Récapitulatif mensuel des revenus',
    ],
  },
  {
    label: '2 ou 3 chambres',
    percent: '22–25 %',
    tag: 'TTC',
    highlight: true,
    services: [
      'Photos professionnelles & annonces optimisées',
      'Tarification dynamique (saisonnalité, événements)',
      'Communication voyageurs 24 h/24, 7 j/7',
      'Organisation check-in / check-out',
      'Coordination ménage & linge de maison',
      'Reporting mensuel détaillé',
    ],
  },
  {
    label: 'Villa · Grand bien',
    percent: '30 %',
    tag: 'TTC',
    services: [
      'Photos professionnelles & annonces optimisées',
      'Tarification dynamique (saisonnalité, événements)',
      'Communication voyageurs 24 h/24, 7 j/7',
      'Organisation check-in / check-out',
      'Coordination ménage & linge de maison',
      'Coordination maintenance & entretien des extérieurs',
    ],
  },
];
---

<section
  id="tarifs"
  class="bg-[var(--color-bg)] py-12 md:py-20 px-4"
  aria-labelledby="tarifs-heading"
>
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-4 fade-in-section">
      <h2
        id="tarifs-heading"
        class="font-serif font-semibold text-[var(--color-primary)]"
        style="font-family:'Fraunces',serif;font-size:clamp(1.75rem,3vw,2.5rem);"
      >
        Une commission claire, qui s'adapte à votre bien
      </h2>
    </div>
    <div class="text-center mb-12 fade-in-section">
      <p class="font-sans text-[var(--color-text)] opacity-70 text-base">
        À partir de 20 % TTC sur les revenus encaissés. Frais de mise en place uniques au lancement.
      </p>
    </div>

    <!-- Grille 3 cards : 1 colonne mobile, 3 colonnes desktop -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      {tarifs.map((t, i) => (
        <div
          class={`fade-in-section flex flex-col rounded-sm border ${t.highlight ? 'border-[var(--color-accent)] shadow-xl' : 'border-[var(--color-border)]'} bg-[var(--color-card)] overflow-hidden`}
          style={`transition-delay:${i * 80}ms;`}
        >
          <!-- En-tête card -->
          <div class={`px-6 pt-8 pb-6 ${t.highlight ? 'bg-[var(--color-primary)]' : ''}`}>
            {t.highlight && (
              <span class="inline-block font-sans text-xs font-semibold uppercase tracking-widest mb-3" style="color:var(--color-accent);">
                Le plus demandé
              </span>
            )}
            <p class={`font-sans font-medium text-xs uppercase tracking-wider mb-3 ${t.highlight ? 'text-white opacity-60' : 'text-[var(--color-text)] opacity-60'}`}>
              {t.label}
            </p>
            <div class="flex items-baseline gap-1 mb-1">
              <span
                class={`font-serif font-bold leading-none ${t.highlight ? 'text-white' : 'text-[var(--color-primary)]'}`}
                style="font-family:'Fraunces',serif;font-size:clamp(2.5rem,5vw,3.25rem);"
                aria-label={`Commission ${t.percent} TTC`}
              >{t.percent}</span>
            </div>
            <span class={`font-sans text-xs font-medium ${t.highlight ? 'text-white opacity-40' : 'text-[var(--color-text)] opacity-40'}`}>{t.tag} · tout inclus</span>
          </div>

          <!-- Liste prestations -->
          <ul class="flex flex-col gap-3 px-6 py-6 flex-1" role="list">
            {t.services.map(s => (
              <li class="flex items-start gap-3 font-sans text-sm text-[var(--color-text)] opacity-80">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 flex-shrink-0 mt-0.5" style="color:var(--color-accent);" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                </svg>
                {s}
              </li>
            ))}
          </ul>

          <!-- Bouton -->
          <div class="px-6 pb-8">
            <button
              class="tarif-simulateur-btn w-full py-3 px-4 font-sans font-medium text-sm rounded-sm transition-colors cursor-pointer text-center"
              style={t.highlight
                ? 'background-color:var(--color-accent);color:#fff;border:1px solid var(--color-accent);'
                : 'border:1px solid var(--color-accent);color:var(--color-accent);background:transparent;'}
              aria-label={`Estimer mes revenus pour un ${t.label}`}
            >
              Estimer mes revenus
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Disclaimer -->
    <div class="fade-in-section max-w-2xl mx-auto text-center">
      <p class="font-sans text-sm italic text-[var(--color-text)] opacity-55 leading-relaxed">
        Notre commission varie selon la taille et la typologie du bien : les biens plus grands nécessitent une logistique opérationnelle plus lourde (rotations, ménage approfondi, gestion technique, entretien des extérieurs). Frais de ménage à la charge des voyageurs. Des frais de mise en place uniques sont facturés au lancement (visite, photos professionnelles, création des annonces, configuration des outils) — montant communiqué lors de notre premier échange.
      </p>
    </div>
  </div>
</section>

<script>
  // Tous les boutons "Estimer mes revenus" de la grille tarifs → scroll vers simulateur
  document.querySelectorAll('.tarif-simulateur-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.getElementById('simulateur')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
