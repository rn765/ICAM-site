---
// Section Tarifs — grille pricing 4 cards, boutons scrollent vers #simulateur
const tarifs = [
  { label: 'Studio / 1 chambre', percent: '20%' },
  { label: '2 chambres',          percent: '22%' },
  { label: '3 chambres',          percent: '25%' },
  { label: 'Villa / grand bien',  percent: '30%' },
];
---

<section
  id="tarifs"
  class="bg-[var(--color-bg)] py-12 md:py-20 px-4"
  aria-labelledby="tarifs-heading"
>
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-4 fade-in-section">
      <h2
        id="tarifs-heading"
        class="font-serif font-semibold text-[var(--color-primary)]"
        style="font-family:'Fraunces',serif;font-size:clamp(1.75rem,3vw,2.5rem);"
      >
        Une commission claire, qui s'adapte à votre bien
      </h2>
    </div>
    <div class="text-center mb-12 fade-in-section">
      <p class="font-sans text-[var(--color-text)] opacity-70 text-base">
        À partir de 20% TTC sur les revenus encaissés. Frais de mise en place uniques au lancement.
      </p>
    </div>

    <!-- Grille 4 cards : 2 colonnes mobile, 4 desktop -->
    <div class="grid grid-cols-2 xl:grid-cols-4 gap-3 md:gap-6 mb-10">
      {tarifs.map((t, i) => (
        <div
          class="fade-in-section bg-[var(--color-card)] border border-[var(--color-border)] rounded-sm px-4 py-6 md:p-8 flex flex-col items-center text-center"
          style={`transition-delay:${i * 80}ms;`}
        >
          <!-- Label type de bien -->
          <span class="font-sans font-medium text-[var(--color-text)] opacity-60 text-xs md:text-sm mb-2 md:mb-3 uppercase tracking-wider leading-tight">
            {t.label}
          </span>

          <!-- Pourcentage — responsive Fraunces -->
          <span
            class="font-serif font-bold text-[var(--color-primary)] leading-none mb-1 md:mb-2 text-4xl md:text-5xl lg:text-6xl"
            style="font-family:'Fraunces',serif;"
            aria-label={`Commission ${t.percent} TTC`}
          >{t.percent}</span>
          <span class="font-sans text-xs font-medium text-[var(--color-text)] opacity-40 mb-1">TTC</span>

          <!-- Badge or laiton -->
          <span
            class="font-sans text-xs font-semibold uppercase tracking-widest mb-4 md:mb-6 mt-1 md:mt-2"
            style="color:var(--color-accent);"
          >Tout inclus</span>

          <!-- Bouton scroll vers simulateur — texte court sur mobile -->
          <button
            class="tarif-simulateur-btn mt-auto w-full py-2 md:py-2.5 px-2 md:px-4 border border-[var(--color-accent)] text-[var(--color-accent)] font-sans font-medium text-xs md:text-sm rounded-sm hover:bg-[var(--color-accent)] hover:text-white transition-colors text-center cursor-pointer"
            aria-label={`Estimer mes revenus pour un ${t.label}`}
          >
            <span class="md:hidden">Estimer</span>
            <span class="hidden md:inline">Estimer mes revenus</span>
          </button>
        </div>
      ))}
    </div>

    <!-- Disclaimer -->
    <div class="fade-in-section max-w-2xl mx-auto text-center">
      <p class="font-sans text-sm italic text-[var(--color-text)] opacity-55 leading-relaxed">
        Notre commission varie selon la taille et la typologie du bien : les biens plus grands nécessitent une logistique opérationnelle plus lourde (rotations, ménage approfondi, gestion technique, entretien des extérieurs). Frais de ménage à la charge des voyageurs. Des frais de mise en place uniques sont facturés au lancement (visite, photos professionnelles, création des annonces, configuration des outils) — montant communiqué lors de notre premier échange.
      </p>
    </div>
  </div>
</section>

<script>
  // Tous les boutons "Estimer mes revenus" de la grille tarifs → scroll vers simulateur
  document.querySelectorAll('.tarif-simulateur-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.getElementById('simulateur')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
