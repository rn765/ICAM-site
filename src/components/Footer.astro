---
// Footer — 3 colonnes desktop / 1 colonne mobile
---

<footer
  class="py-16 px-4"
  style="background-color:#EBE5DB;"
  role="contentinfo"
>
  <div class="max-w-6xl mx-auto">
    <!-- Grille 3 colonnes -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-10">

      <!-- Colonne 1 : Logo + tagline + adresse -->
      <div>
        <div class="flex items-baseline gap-1.5 mb-3">
          <span
            class="font-serif font-semibold text-xl text-[var(--color-primary)]"
            style="font-family:'Fraunces',serif;"
          >ICAM</span>
          <span class="font-sans font-normal text-sm text-[var(--color-text)] opacity-70">Conciergerie</span>
        </div>
        <p class="font-sans text-sm text-[var(--color-text)] opacity-60 mb-4 leading-relaxed">
          Conciergerie immobilière en Belgique
        </p>
        <address class="not-italic font-sans text-sm text-[var(--color-text)] opacity-60 leading-relaxed">
          Avenue Louise 367<br />
          1050 Bruxelles
        </address>
      </div>

      <!-- Colonne 2 : Contact -->
      <div>
        <h3 class="font-sans font-semibold text-sm text-[var(--color-primary)] uppercase tracking-wider mb-4">
          Contact
        </h3>
        <ul class="space-y-2 list-none">
          <li>
            <a
              href="tel:+32471596624"
              class="font-sans text-sm text-[var(--color-text)] opacity-70 hover:text-[var(--color-accent)] hover:opacity-100 transition-colors"
            >+32 471 59 66 24</a>
          </li>
          <li>
            <a
              href="mailto:contact@icam-conciergerie.com"
              class="font-sans text-sm text-[var(--color-text)] opacity-70 hover:text-[var(--color-accent)] hover:opacity-100 transition-colors"
            >contact@icam-conciergerie.com</a>
          </li>
        </ul>
      </div>

      <!-- Colonne 3 : Légal -->
      <div>
        <h3 class="font-sans font-semibold text-sm text-[var(--color-primary)] uppercase tracking-wider mb-4">
          Légal
        </h3>
        <ul class="space-y-2 list-none">
          <li class="font-sans text-sm text-[var(--color-text)] opacity-60">
            ICAM GROUP SRL · BE 0762.846.701
          </li>
          <li>
            <a href="/mentions-legales" class="font-sans text-sm text-[var(--color-text)] opacity-70 hover:text-[var(--color-accent)] hover:opacity-100 transition-colors">
              Mentions légales
            </a>
          </li>
          <li>
            <a href="/politique-confidentialite" class="font-sans text-sm text-[var(--color-text)] opacity-70 hover:text-[var(--color-accent)] hover:opacity-100 transition-colors">
              Politique de confidentialité
            </a>
          </li>
          <li>
            <a href="/cookies" class="font-sans text-sm text-[var(--color-text)] opacity-70 hover:text-[var(--color-accent)] hover:opacity-100 transition-colors">
              Cookies
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-[var(--color-border)] pt-8">
      <p class="font-sans text-xs text-[var(--color-text)] opacity-50 text-center">
        © 2026 ICAM GROUP SRL · Tous droits réservés
      </p>
    </div>
  </div>
</footer>
