---
// Layout principal — ICAM Conciergerie
import '../styles/global.css';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ICAM Conciergerie Bruxelles — Gestion Airbnb & Booking conforme BEE 2026',
  description = '+25% de revenus locatifs sur votre Airbnb à Bruxelles. Estimation gratuite en 30 secondes. 100% conforme BEE & taxe de séjour 2026.'
} = Astro.props;

// Schema.org LocalBusiness JSON-LD
const schemaLD = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "ICAM Conciergerie",
  "description": description,
  "url": "https://www.icam-conciergerie.com",
  "telephone": "+32471596624",
  "email": "contact@icam-conciergerie.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Avenue Louise 367",
    "addressLocality": "Bruxelles",
    "postalCode": "1050",
    "addressCountry": "BE"
  },
  "areaServed": {
    "@type": "City",
    "name": "Bruxelles"
  },
  "serviceType": "Conciergerie immobilière, Gestion location courte durée Airbnb"
};
---

<!doctype html>
<html lang="fr-BE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="conciergerie Airbnb Belgique, gestion locative Bruxelles, conciergerie Bruxelles, location courte durée Belgique" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/icam-logo.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.icam-conciergerie.com" />
    <meta property="og:locale" content="fr_BE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/icam-logo.png" />

    <link rel="canonical" href={`https://www.icam-conciergerie.com${Astro.url.pathname}`} />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/icam-logo.png" />
    <link rel="apple-touch-icon" href="/icam-logo.png" />

    <!-- Google Fonts : Fraunces (titres) + Inter (corps) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaLD)} />

    <!-- Meta Pixel — 1721388932547097 -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window,document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init','1721388932547097');
      fbq('track','PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=1721388932547097&ev=PageView&noscript=1" />
    </noscript>
    <!-- End Meta Pixel -->

    <!-- Google Analytics 4 — G-JLPNK6GMFT -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JLPNK6GMFT" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JLPNK6GMFT');
    </script>
  </head>
  <body>
    <!-- Skip link pour navigation au clavier -->
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>

    <slot />

    <!-- Bouton flottant WhatsApp — présent sur toutes les pages -->
    <WhatsAppFloat />

    <!-- ===== SCRIPTS GLOBAUX ===== -->
    <script>
      // Intersection Observer — animations fade-in au scroll
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );

      document.querySelectorAll('.fade-in-section').forEach((el) => {
        observer.observe(el);
      });

      // ===== CLICK TRACKING — GA4 + Meta Pixel =====
      const FBQ_MAP: Record<string, () => void> = {
        click_whatsapp:  () => (window as any).fbq?.('track', 'Lead',        { content_name: 'WhatsApp Contact',  content_category: 'whatsapp'  }),
        click_simulator: () => (window as any).fbq?.('track', 'ViewContent', { content_name: 'Simulator Click',   content_category: 'simulator' }),
        click_email:     () => (window as any).fbq?.('track', 'Contact',     { content_name: 'Email Click'        }),
      };

      document.addEventListener('click', (e) => {
        const el = (e.target as Element).closest('[data-track]') as HTMLElement | null;
        if (!el) return;
        const event = el.dataset.track as string;
        const location = el.dataset.trackLocation ?? 'unknown';

        // GA4
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', event, { location });
        }

        // Meta Pixel
        FBQ_MAP[event]?.();
      });

      // Nav sticky — ombre au scroll
      const nav = document.getElementById('main-nav');
      if (nav) {
        window.addEventListener('scroll', () => {
          nav.classList.toggle('shadow-md', window.scrollY > 10);
        }, { passive: true });
      }
    </script>
  </body>
</html>
